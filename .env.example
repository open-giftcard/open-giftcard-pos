# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored and must never be committed.

# The till authenticates as a device against the platform backend.
Pos__BackendBaseUrl=http://127.0.0.1:5143

# Registered through the permission-protected API. The client secret is
# returned exactly once at registration and only its hash is stored, so there
# is no recovery endpoint. Supply it through user secrets or the environment;
# the application refuses to start without it.
Pos__ClientCode=TILL-DEMO
Pos__TerminalCode=T-01
# Pos__ClientSecret=set-via-user-secrets-or-environment-never-committed
